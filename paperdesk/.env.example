# Copy to .env.local. Keep real tokens and AI secrets out of Git.
# Storage is Google Drive; no Supabase project or variables are required.
# Enable Google Drive API + Google Picker API in one Google Cloud project.
# Create a Web OAuth client and register exact local/production origins.
# Browser OAuth scopes: openid email profile drive.file drive.appdata.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Public Picker API key: restrict referrers and APIs (see README).
NEXT_PUBLIC_GOOGLE_API_KEY=
# Numeric Google Cloud project number, not its text project ID.
NEXT_PUBLIC_GOOGLE_APP_ID=
# Server-only allowlist: Google emails, comma separated. Empty fails closed.
ALLOWED_EMAILS=

# Server secrets and currently available model IDs (comma separated).
GEMINI_API_KEY=
GEMINI_MODELS=
ANTHROPIC_API_KEY=
CLAUDE_MODELS=

# Separate Codex runner. See codex-runner/README.md.
CODEX_RUNNER_URL=
CODEX_RUNNER_SECRET=
CODEX_MODELS=

# Local development on loopback only. Not for Vercel/production.
ALLOW_LOCAL_DEV=false
# Optional contact email for scholarly metadata API requests.
CROSSREF_MAILTO=
